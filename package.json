{
  "name": "screenshot-to-code",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend --prefix-colors blue,green \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn main:app --reload --port 7001",
    "dev:frontend": "pnpm -C frontend dev --port 5173 --strictPort",
    "test": "pnpm run test:frontend && pnpm run test:backend",
    "test:frontend": "pnpm -C frontend test",
    "test:backend": "cd backend && poetry run pytest"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
